generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
model League { id String @id @default(cuid()) name String @default("Big Baller League") seasons Season[] imports Import[] createdAt DateTime @default(now()) }
model Season { id String @id @default(cuid()) year Int leagueId String league League @relation(fields:[leagueId],references:[id]) weeks Week[] games Game[] awards Award[] @@unique([leagueId,year]) }
model Week { id String @id @default(cuid()) number Int seasonId String season Season @relation(fields:[seasonId],references:[id]) snapshots Snapshot[] articles Article[] @@unique([seasonId,number]) }
model Team { id String @id @default(cuid()) externalId String @unique name String city String abbreviation String conference String? division String? primaryColor String? players Player[] homeGames Game[] @relation("HomeTeam") awayGames Game[] @relation("AwayTeam") snapshots TeamSnapshot[] transactions Transaction[] history TeamHistoryEvent[] }
model Player { id String @id @default(cuid()) externalId String @unique firstName String lastName String position String? jersey Int? age Int? overall Int? teamId String? team Team? @relation(fields:[teamId],references:[id]) stats PlayerGameStat[] transactions Transaction[] awards Award[] }
model Game { id String @id @default(cuid()) externalId String @unique seasonId String season Season @relation(fields:[seasonId],references:[id]) week Int homeTeamId String awayTeamId String homeTeam Team @relation("HomeTeam",fields:[homeTeamId],references:[id]) awayTeam Team @relation("AwayTeam",fields:[awayTeamId],references:[id]) homeScore Int? awayScore Int? status String @default("scheduled") playerStats PlayerGameStat[] }
model PlayerGameStat { id String @id @default(cuid()) gameId String game Game @relation(fields:[gameId],references:[id]) playerId String player Player @relation(fields:[playerId],references:[id]) passingYards Int @default(0) passingTD Int @default(0) interceptions Int @default(0) rushingYards Int @default(0) rushingTD Int @default(0) receptions Int @default(0) receivingYards Int @default(0) receivingTD Int @default(0) tackles Int @default(0) sacks Float @default(0) defensiveINT Int @default(0) fantasyPPR Float @default(0) @@unique([gameId,playerId]) }
model Snapshot { id String @id @default(cuid()) weekId String week Week @relation(fields:[weekId],references:[id]) type String raw Json importedAt DateTime @default(now()) }
model TeamSnapshot { id String @id @default(cuid()) teamId String team Team @relation(fields:[teamId],references:[id]) season Int week Int wins Int losses Int ties Int @default(0) pointsFor Int @default(0) pointsAgainst Int @default(0) powerScore Float? playoffProbability Float? championshipProbability Float? @@unique([teamId,season,week]) }
model Transaction { id String @id @default(cuid()) playerId String? player Player? @relation(fields:[playerId],references:[id]) teamId String? team Team? @relation(fields:[teamId],references:[id]) type String details String? season Int week Int createdAt DateTime @default(now()) }
model Article { id String @id @default(cuid()) slug String @unique headline String deck String? body String category String @default("News") isEditorial Boolean @default(false) weekId String? week Week? @relation(fields:[weekId],references:[id]) publishedAt DateTime @default(now()) }
model Award { id String @id @default(cuid()) name String seasonId String season Season @relation(fields:[seasonId],references:[id]) playerId String? player Player? @relation(fields:[playerId],references:[id]) }
model TeamHistoryEvent { id String @id @default(cuid()) teamId String team Team @relation(fields:[teamId],references:[id]) season Int week Int? type String title String description String? importance Int @default(1) }
model Import { id String @id @default(cuid()) leagueId String league League @relation(fields:[leagueId],references:[id]) type String season Int? week Int? status String @default("received") rowCount Int @default(0) checksum String? payload Json receivedAt DateTime @default(now()) }
